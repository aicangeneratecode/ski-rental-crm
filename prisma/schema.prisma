generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Equipment {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique @db.VarChar(40)
  name         String        @db.VarChar(120)
  tariff       String        @db.VarChar(40)
  size         String        @db.VarChar(40)
  dailyRate    Int
  status       String        @default("READY") @db.VarChar(20)
  notes        String        @default("") @db.VarChar(2000)
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookingItems BookingItem[]
  maintenanceRecords EquipmentMaintenance[]

  @@index([status, tariff])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  bookings Booking[]
  payments Payment[]
  bookingEvents BookingEvent[]
  maintenanceEvents EquipmentMaintenance[]
  customerMerges CustomerMerge[]
  tariffChanges TariffChange[]
  settingsChanges WorkspaceSettingsChange[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  phone     String   @db.VarChar(20)
  email     String   @default("") @db.VarChar(254)
  notes     String   @default("") @db.VarChar(2000)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  mergedIntoId String? @db.Uuid
  mergedInto Customer? @relation("CustomerAliases", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedAliases Customer[] @relation("CustomerAliases")
  sourceMerges CustomerMerge[] @relation("CustomerMergeSource")
  targetMerges CustomerMerge[] @relation("CustomerMergeTarget")

  @@index([mergedIntoId])
  @@index([phone])
  @@index([name])
}

enum BookingStatus {
  RESERVED
  ISSUED
  RETURNED
  CANCELLED
}

model Booking {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date
  status    BookingStatus @default(RESERVED)

  travelDay       Boolean @default(false)
  discountPercent Int     @default(0)
  paidDays        Int
  subtotal        Int
  discountAmount  Int
  total           Int

  notes     String   @default("") @db.VarChar(2000)
  archivedAt DateTime?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    BookingItem[]
  payments Payment[]
  events BookingEvent[]

  @@index([customerId])
  @@index([createdById])
  @@index([status, startDate, endDate])
  @@index([archivedAt, status])
}

model BookingItem {
  id          String    @id @default(uuid()) @db.Uuid
  bookingId   String    @db.Uuid
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  equipmentId String    @db.Uuid
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  equipmentCode String  @db.VarChar(40)
  equipmentName String  @db.VarChar(120)
  dailyRate     Int
  complimentary Boolean @default(false)
  amount        Int

  @@unique([bookingId, equipmentId])
  @@index([equipmentId])
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  kind   PaymentKind   @default(PAYMENT)
  method PaymentMethod
  amount Int

  note      String   @default("") @db.VarChar(1000)
  createdAt DateTime @default(now())

  requestId String @unique @db.Uuid

  @@index([bookingId, createdAt])
  @@index([createdById])
}


enum BookingEventKind {
  CREATED
  ISSUED
  RETURNED
  CANCELLED
  ARCHIVED
  RESTORED
  UPDATED
  EXTENDED
  CUSTOMER_MERGED
}

model BookingEvent {
  id String @id @default(uuid()) @db.Uuid
  bookingId String @db.Uuid
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  kind BookingEventKind
  details String @default("") @db.VarChar(2000)
  bookingVersion Int
  createdAt DateTime @default(now())
  @@unique([bookingId, bookingVersion])
  @@index([bookingId, createdAt])
  @@index([actorId])
}

enum EquipmentMaintenanceKind {
  CHECK_OUT
  CHECK_IN
  INSPECTION
  SERVICE
  DAMAGE
}

model EquipmentMaintenance {
  id String @id @default(uuid()) @db.Uuid
  equipmentId String @db.Uuid
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  kind EquipmentMaintenanceKind
  condition String @default("") @db.VarChar(30)
  note String @default("") @db.VarChar(1500)
  bookingId String? @db.Uuid
  createdAt DateTime @default(now())

  @@index([equipmentId, createdAt])
  @@index([bookingId])
}

model CustomerMerge {
  id String @id @default(uuid()) @db.Uuid
  sourceId String @db.Uuid
  source Customer @relation("CustomerMergeSource", fields: [sourceId], references: [id], onDelete: Restrict)
  targetId String @db.Uuid
  target Customer @relation("CustomerMergeTarget", fields: [targetId], references: [id], onDelete: Restrict)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  bookingsMoved Int
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([sourceId])
}

model TariffRate {
  code String @id @db.VarChar(40)
  rate Int?
  version Int @default(1)
  updatedAt DateTime @updatedAt
  changes TariffChange[]
}

model TariffChange {
  id String @id @default(uuid()) @db.Uuid
  code String @db.VarChar(40)
  tariff TariffRate @relation(fields: [code], references: [code], onDelete: Restrict)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  previousRate Int?
  newRate Int?
  affectedItems Int @default(0)
  createdAt DateTime @default(now())

  @@index([code, createdAt])
}

model WorkspaceSettings {
  id String @id @default("default") @db.VarChar(20)
  businessName String @default("TOP RIDE") @db.VarChar(120)
  contactPhone String @default("") @db.VarChar(40)
  contactAddress String @default("") @db.VarChar(250)
  customerNote String @default("") @db.VarChar(1000)
  version Int @default(1)
  updatedAt DateTime @updatedAt
  changes WorkspaceSettingsChange[]
}

model WorkspaceSettingsChange {
  id String @id @default(uuid()) @db.Uuid
  settingsId String @db.VarChar(20)
  settings WorkspaceSettings @relation(fields: [settingsId], references: [id], onDelete: Restrict)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([settingsId, createdAt])
}
